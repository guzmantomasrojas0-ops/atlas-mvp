# Copiar a .env y ajustar según el entorno local.

# Cadena de conexión a PostgreSQL usada por Prisma.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# El `options=-c TimeZone=UTC` (URL-encodeado) es obligatorio, no cosmético:
# fuerza el `TimeZone` de la sesión de Postgres a UTC. Sin esto, si el server
# tiene configurado un TimeZone de sesión distinto de UTC (ej. la del SO),
# `@prisma/adapter-pg` escribe y lee columnas `Timestamptz` como si fueran
# hora local de esa sesión — cada escritura/lectura vía Prisma se auto-cancela
# y "parece" correcta, pero el valor real guardado en disco queda corrido por
# el offset de esa zona horaria. Solo se nota al comparar contra un dato
# escrito por otro cliente que sí respeta el offset (ej. `pg` crudo con un
# objeto `Date`) — así se descubrió este bug en Sprint 19.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas_mvp?schema=public&options=-c%20TimeZone%3DUTC"

# Base de datos temporal que usa `prisma migrate diff`/`migrate dev` para calcular
# migraciones. Debe ser una base vacía separada, no la de desarrollo.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas_mvp_shadow?schema=public&options=-c%20TimeZone%3DUTC"

# Qué proveedor de IA usa todo el proyecto (módulo `ai`) — "openai", "anthropic" o
# "gemini". Cambiar este valor (y reiniciar) alcanza para cambiar de proveedor en
# todo el proyecto sin tocar ningún otro archivo. Si se omite, usa "openai".
# "openai" y "gemini" todavía devuelven una respuesta simulada (ver Sprint 10).
# "anthropic" ya es real (ver Sprint 11) y necesita ANTHROPIC_API_KEY.
AI_PROVIDER="openai"

# Credencial real de Anthropic — solo hace falta si AI_PROVIDER="anthropic".
# Conseguí una key en https://console.anthropic.com/. Sin esta variable, el
# provider de Anthropic tira MissingCredentialsError recién al usarlo (no al
# arrancar la app).
ANTHROPIC_API_KEY=""

# WhatsApp Cloud API (Meta) — Sprint 16, usadas por messaging/adapters/whatsapp.
# Access token de la app de Meta, con permiso whatsapp_business_messaging —
# se usa para autenticar los envíos salientes (Authorization: Bearer ...).
WHATSAPP_ACCESS_TOKEN=""
# El "Phone Number ID" del número de WhatsApp Business conectado (no es el
# número de teléfono en sí) — identifica desde qué número se envía.
WHATSAPP_PHONE_NUMBER_ID=""
# String arbitrario elegido por vos, configurado también en el panel de Meta
# al crear la suscripción del webhook — Meta lo reenvía tal cual en el
# handshake GET (?hub.verify_token=...) para confirmar que el endpoint es tuyo.
WHATSAPP_VERIFY_TOKEN=""
# El App Secret de la app de Meta (distinto del access token, se ve en
# Configuración básica de la app). El brief del Sprint 16 no lo listaba entre
# las variables a agregar, pero sin él es imposible validar la firma
# HMAC-SHA256 (header X-Hub-Signature-256) que Meta manda en cada webhook —
# se agregó porque el propio brief exige "validar la firma de Meta".
WHATSAPP_APP_SECRET=""

# Sin estas cuatro variables, el WhatsAppAdapter tira MissingWhatsAppCredentialsError
# recién al usarse (no al arrancar la app) — igual que el resto de las
# credenciales de este proyecto.

# Secreto que valida quién puede disparar POST /api/cron/notifications (el
# "Scheduler" de notifications/ — ver Sprint 20). Sin autenticación todavía
# (Sprint 21), así que cualquiera que conozca la URL podría spamear el envío
# de recordatorios si no se valida esto. El disparador (Vercel Cron, ver
# vercel.json, o cualquier cron externo) debe mandar
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
