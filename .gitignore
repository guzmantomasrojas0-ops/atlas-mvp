# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# office lock files
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local session state
.claude/settings.local.json

# playwright
/playwright-report/
/test-results/
/blob-report/

# prisma
prisma/dev.db*

/src/generated/prisma

# backups locales de scripts/backup-db.sh — contienen datos reales de
# clientes (nombres, teléfonos, mensajes). Nunca deben subirse al repo.
/backups/
